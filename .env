# MySQL Database Configuration (XAMPP Local Development)
# XAMPP defaults: localhost, port 3306, user root, no password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=taskFlow

# Session Configuration
SESSION_SECRET=dev-session-secret-change-in-production

# Node Environment
NODE_ENV=development
PORT=5001
